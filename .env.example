# SecureVault Environment Configuration
#
# This project runs as a Windows Service on Windows Server with Microsoft
# SQL Server as the database. Application environment variables live in
# C:\ProgramData\SecureVault\securevault.env, which is loaded into the
# service's registry Environment block by scripts/install-windows-service.ps1.
# See scripts/securevault.env.example for the full template.
#
# This file is retained for the PowerShell backup/restore scripts and the
# db-setup.sql script when run from a developer workstation that prefers
# shell-style environment variables.
# NEVER commit a populated copy to version control.

# ─────────────────────────────────────────────────────────────────────────────
# SQL Server connection (used by scripts/db-setup.sql when creating the
# application login). DbName, AppLogin, AppPassword are passed as sqlcmd
# variables via -v.
# ─────────────────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme_strong_password_here

# ─────────────────────────────────────────────────────────────────────────────
# Filesystem paths to the host-managed secret files.
# ACL'd to NT SERVICE\SecureVault read-only and BUILTIN\Administrators full.
# ─────────────────────────────────────────────────────────────────────────────
SECUREVAULT_KEY_FILE=C:\ProgramData\SecureVault\secrets\securevault-mek.bin
JWT_KEY_PATH=C:\ProgramData\SecureVault\secrets\jwt-signing.pem

# ─────────────────────────────────────────────────────────────────────────────
# Backup script (scripts/backup.ps1)
# ─────────────────────────────────────────────────────────────────────────────
SECUREVAULT_BACKUP_DIR=C:\ProgramData\SecureVault\backups
SECUREVAULT_BACKUP_PASSPHRASE=C:\ProgramData\SecureVault\secrets\backup-passphrase.txt
SECUREVAULT_BACKUP_RETENTION_DAYS=30
SECUREVAULT_DB_SERVER=localhost
SECUREVAULT_DB_NAME=securevault

# ─────────────────────────────────────────────────────────────────────────────
# TLS — IIS binds these from the Windows cert store (LocalMachine\My).
# Use the cert thumbprint when invoking install-iis-site.ps1.
# ─────────────────────────────────────────────────────────────────────────────
TLS_CERT_THUMBPRINT=
