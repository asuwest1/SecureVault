# SecureVault Environment Configuration
#
# This project runs natively on the host (not in Docker). Application
# environment variables live in /etc/securevault/securevault.env, which is
# loaded by the systemd unit at scripts/securevault.service. See
# scripts/securevault.env.example for the full template.
#
# This file is retained only for shell scripts (backup/restore) and the
# database setup script that read variables from the environment.
# NEVER commit a populated copy to version control.

# ─────────────────────────────────────────────────────────────────────────────
# Database (used by scripts/db-setup.sql when creating the application role)
# ─────────────────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme_strong_password_here

# ─────────────────────────────────────────────────────────────────────────────
# Filesystem paths to the host-managed secret files
# Owned by the 'securevault' service user, mode 0400.
# ─────────────────────────────────────────────────────────────────────────────
SECUREVAULT_KEY_FILE=/etc/securevault/secrets/securevault-mek
JWT_KEY_PATH=/etc/securevault/secrets/jwt-signing.pem

# ─────────────────────────────────────────────────────────────────────────────
# Backup script (scripts/backup.sh)
# ─────────────────────────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/securevault
BACKUP_PASSPHRASE_FILE=/etc/securevault/secrets/backup-passphrase
BACKUP_RETENTION_DAYS=30
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=securevault
DB_USER=postgres
# PGPASSWORD is read by pg_dump; prefer ~/.pgpass for the postgres superuser.
# PGPASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# TLS — Nginx serves these directly from the host filesystem
# ─────────────────────────────────────────────────────────────────────────────
TLS_CERT_PATH=/etc/nginx/certs
