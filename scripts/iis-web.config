<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse-proxy config for SecureVault.
  Forwards all traffic to the Kestrel backend on http://127.0.0.1:8080
  and injects the security headers TechSpec §7.2 expects.

  Requires URL Rewrite + ARR 3.0 to be installed at the server level.
-->
<configuration>
  <system.webServer>

    <!-- 10 MB request body limit (matches Kestrel) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
        <hiddenSegments>
          <add segment="web.config" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Disable HTTPS response compression: CRIME/BREACH mitigation -->
    <httpCompression>
      <staticTypes>
        <clear />
      </staticTypes>
      <dynamicTypes>
        <clear />
      </dynamicTypes>
    </httpCompression>
    <urlCompression doDynamicCompression="false" doStaticCompression="false" />

    <!-- URL Rewrite: forward everything to the Kestrel backend -->
    <rewrite>
      <rules>
        <!-- HTTP → HTTPS -->
        <rule name="ForceHttps" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:0}" redirectType="Permanent" />
        </rule>

        <!-- Reverse proxy to Kestrel -->
        <rule name="ProxyToKestrel" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR"  value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>

      <!-- Allow setting the X-Forwarded-* server variables above. -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
        <add name="HTTP_X_FORWARDED_HOST" />
        <add name="HTTP_X_FORWARDED_FOR" />
      </allowedServerVariables>
    </rewrite>

    <!-- Security headers (sent to the browser regardless of backend output) -->
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
        <add name="X-Content-Type-Options"    value="nosniff" />
        <add name="X-Frame-Options"           value="DENY" />
        <add name="Referrer-Policy"           value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy"        value="geolocation=(), microphone=(), camera=()" />
        <add name="Content-Security-Policy"   value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
        <!-- Strip server fingerprinting -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- ARR proxy needs to be enabled at server level for the rewrite rule to forward. -->
    <proxy enabled="true" preserveHostHeader="true" reverseRewriteHostInResponseHeaders="false" />

    <!-- Drop the IIS server header -->
    <serverRuntime removeServerHeader="true" />

  </system.webServer>
</configuration>
