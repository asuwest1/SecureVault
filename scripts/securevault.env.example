# SecureVault Windows Service environment file
# Copy to C:\ProgramData\SecureVault\securevault.env and fill in real values.
# install-windows-service.ps1 loads these values into the service's MultiString
# Environment registry value at HKLM\SYSTEM\CurrentControlSet\Services\SecureVault.
# Format: KEY=VALUE per line. Lines starting with # are ignored.

# ─────────────────────────────────────────────────────────────────────────────
# ASP.NET Core
# ─────────────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8080

# ─────────────────────────────────────────────────────────────────────────────
# Database connection (SQL Server)
# Use Windows Authentication where possible. With a virtual service account,
# grant DB access to "NT SERVICE\SecureVault" in T-SQL.
# ─────────────────────────────────────────────────────────────────────────────
# SQL login form:
ConnectionStrings__Default=Server=localhost;Database=securevault;User Id=securevault_app;Password=CHANGEME;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True
# Or, Integrated Security with the service account:
# ConnectionStrings__Default=Server=localhost;Database=securevault;Integrated Security=True;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True

# ─────────────────────────────────────────────────────────────────────────────
# Secrets (files under C:\ProgramData\SecureVault\secrets, NTFS-ACLed to
# NT SERVICE\SecureVault read-only and Administrators full)
# ─────────────────────────────────────────────────────────────────────────────
SECUREVAULT_KEY_FILE=C:\ProgramData\SecureVault\secrets\securevault-mek.bin
Auth__JwtSigningKeyPath=C:\ProgramData\SecureVault\secrets\jwt-signing.pem

# Backup script settings
SECUREVAULT_BACKUP_DIR=C:\ProgramData\SecureVault\backups
SECUREVAULT_BACKUP_PASSPHRASE=C:\ProgramData\SecureVault\secrets\backup-passphrase.txt
SECUREVAULT_DB_SERVER=localhost
SECUREVAULT_DB_NAME=securevault

# ─────────────────────────────────────────────────────────────────────────────
# Auth mode: local | ldap
# ─────────────────────────────────────────────────────────────────────────────
Auth__Mode=local

# ─────────────────────────────────────────────────────────────────────────────
# Optional: LDAP / Active Directory
# ─────────────────────────────────────────────────────────────────────────────
# Auth__Ldap__Host=ldap.example.com
# Auth__Ldap__Port=636
# Auth__Ldap__UseSsl=true
# Auth__Ldap__BaseDn=dc=example,dc=com
# Auth__Ldap__BindDn=cn=securevault-svc,ou=service-accounts,dc=example,dc=com
# Auth__Ldap__BindPassword=CHANGEME
# Auth__Ldap__UserSearchFilter=(sAMAccountName={0})

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Syslog forwarding
# ─────────────────────────────────────────────────────────────────────────────
Syslog__Host=
Syslog__UseTls=true

# ─────────────────────────────────────────────────────────────────────────────
# Allowed Host headers (comma separated)
# ─────────────────────────────────────────────────────────────────────────────
AllowedHosts=vault.example.com
