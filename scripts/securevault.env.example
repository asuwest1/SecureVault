# SecureVault systemd EnvironmentFile
# Copy to /etc/securevault/securevault.env and fill in real values.
# This file is loaded by securevault.service; format: KEY=VALUE per line.

# ─────────────────────────────────────────────────────────────────────────────
# ASP.NET Core
# ─────────────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8080

# ─────────────────────────────────────────────────────────────────────────────
# Database connection (PostgreSQL on localhost)
# ─────────────────────────────────────────────────────────────────────────────
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=securevault;Username=securevault_app;Password=CHANGEME

# ─────────────────────────────────────────────────────────────────────────────
# Secrets (filesystem paths owned by the securevault user, mode 0400)
# ─────────────────────────────────────────────────────────────────────────────
SECUREVAULT_KEY_FILE=/etc/securevault/secrets/securevault-mek
Auth__JwtSigningKeyPath=/etc/securevault/secrets/jwt-signing.pem

# ─────────────────────────────────────────────────────────────────────────────
# Auth mode: local | ldap
# ─────────────────────────────────────────────────────────────────────────────
Auth__Mode=local

# ─────────────────────────────────────────────────────────────────────────────
# Optional: LDAP / Active Directory
# ─────────────────────────────────────────────────────────────────────────────
# Auth__Ldap__Host=ldap.example.com
# Auth__Ldap__Port=636
# Auth__Ldap__UseSsl=true
# Auth__Ldap__BaseDn=dc=example,dc=com
# Auth__Ldap__BindDn=cn=securevault-svc,ou=service-accounts,dc=example,dc=com
# Auth__Ldap__BindPassword=CHANGEME
# Auth__Ldap__UserSearchFilter=(sAMAccountName={0})

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Syslog forwarding
# ─────────────────────────────────────────────────────────────────────────────
Syslog__Host=
Syslog__UseTls=true

# ─────────────────────────────────────────────────────────────────────────────
# Allowed Host headers (comma separated)
# ─────────────────────────────────────────────────────────────────────────────
AllowedHosts=vault.example.com
